rules_version = '2';

// قواعد أمان بُنيان (T2.10 + T3.11 + T8.5)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // المستخدمون: كلٌّ يقرأ مستنده، ولا يرقّي نفسه مديراً أبداً
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.role == 'user';
      // المدير يغيّر حقل الدور وحده، ولا يغيّر دوره هو فلا تبقى المنصة بلا مدير (T8.5)
      allow update: if (isSelf(uid) && unchanged('role'))
        || (isAdmin() && uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['user', 'admin']);
      allow delete: if isAdmin();
    }

    // المشاريع: المالك يكتب، والمشترَك يقرؤه أي مستخدم مسجّل.
    // المدير يقرأ مستند المشروع (لعدّه في الإحصاءات) لا مجموعاته الفرعية (T8.5)
    match /projects/{projectId} {
      function project() { return get(/databases/$(database)/documents/projects/$(projectId)).data; }
      function canRead(data) {
        return isSelf(data.ownerId) || (signedIn() && data.get('isShared', false) == true);
      }

      allow read: if canRead(resource.data) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('description', '').size() <= 5000;
      allow update: if isSelf(resource.data.ownerId)
        && unchanged('ownerId')
        && request.resource.data.get('description', '').size() <= 5000;
      allow delete: if isSelf(resource.data.ownerId);

      // المجموعات الفرعية: analyses وdiagrams وdatabaseDesigns وreports
      match /{sub}/{docId} {
        allow read: if canRead(project());
        allow write: if isSelf(project().ownerId);
      }
    }

    // عدّ التحليلات على مستوى المنصة (T8.3): استعلام collectionGroup للمدير وحده
    match /{path=**}/analyses/{analysisId} {
      allow read: if isAdmin();
    }

    // القوالب، أي الأمثلة الجاهزة (T8.4): المنشور يقرؤه كل مسجّل، والمدير وحده يكتب
    match /templates/{templateId} {
      function validTemplate(d) {
        return d.keys().hasOnly(['title', 'description', 'language', 'published', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.description is string && d.description.size() <= 5000
          && d.language in ['ar', 'en']
          && d.published is bool;
      }
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin() && validTemplate(request.resource.data);
      allow delete: if isAdmin();
    }

    // عدّاد الاستخدام اليومي (T4.11 / T4.12)
    // اليوم عدد صحيح بتوقيت UTC مثل 20261121، يُحسب من وقت الخادم فلا يمكن تزويره
    function today() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function dailyLimit() {
      let path = /databases/$(database)/documents/settings/limits;
      return exists(path) ? get(path).data.get('dailyAnalyses', 10) : 10;
    }
    match /usage/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // الزيادة بمقدار 1 فقط، أو البدء من 1 في يوم جديد، دون تجاوز الحدّ
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['day', 'count', 'updatedAt'])
        && request.resource.data.day == today()
        && request.resource.data.count == (
             resource == null || resource.data.day != today() ? 1 : resource.data.count + 1)
        && request.resource.data.count <= dailyLimit();
      allow delete: if isAdmin();
    }

    // إعدادات عامة (حدّ الاستخدام): يقرؤها المسجّل ويكتبها المدير
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
