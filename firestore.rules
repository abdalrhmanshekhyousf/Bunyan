rules_version = '2';

// قواعد أمان Data Analytics (T2.10 + T3.11 + T8.5 + حظر المستخدمين وحذفهم)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    // المحظور (ومنه المحذوف) لا يكتب شيئاً ولا يقرأ المشاريع، وإن بقي حسابه في Authentication
    function isBanned(uid) {
      return exists(userDoc(uid)) && get(userDoc(uid)).data.get('banned', false) == true;
    }
    function active() { return signedIn() && !isBanned(request.auth.uid); }
    function isSelf(uid) { return active() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && get(userDoc(request.auth.uid)).data.role == 'admin';
    }
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // المستخدمون: كلٌّ يقرأ مستنده (ولو محظوراً، ليعرف حاله)، ولا يرقّي نفسه مديراً أبداً
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.role == 'user'
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('deleted', false) == false;
      allow update: if (isSelf(uid) && unchanged('role') && unchanged('banned') && unchanged('deleted'))
        // المدير لا يغيّر مستنده هو، فلا تبقى المنصة بلا مدير (T8.5)
        || (isAdmin() && uid != request.auth.uid && adminUserUpdate());
      allow delete: if isAdmin();

      // ما يجوز للمدير في مستند غيره:
      // - تغيير الدور لمستخدم غير محظور
      // - حظر مستخدم عادي أو رفع حظره (لا يُحظر مدير؛ يُعاد مستخدماً أولاً)
      // - وسم المحظور محذوفاً بعد حذف بياناته، مع محو اسمه وصورته. والمحذوف لا يعود
      function adminUserUpdate() {
        let d = request.resource.data;
        let keys = d.diff(resource.data).affectedKeys();
        return resource.data.get('deleted', false) == false && (
          (keys.hasOnly(['role']) && d.role in ['user', 'admin']
            && resource.data.get('banned', false) == false)
          || (keys.hasOnly(['banned', 'bannedAt']) && d.banned is bool && resource.data.role == 'user')
          || (keys.hasOnly(['deleted', 'deletedAt', 'displayName', 'photoURL'])
            && d.deleted == true && resource.data.get('banned', false) == true
            && d.get('displayName', '') == '' && d.get('photoURL', null) == null)
        );
      }
    }

    // المشاريع: المالك يكتب، والمشترَك يقرؤه أي مستخدم مسجّل.
    // المدير يقرأ مستند المشروع (لعدّه في الإحصاءات) لا مجموعاته الفرعية (T8.5)
    match /projects/{projectId} {
      function project() { return get(/databases/$(database)/documents/projects/$(projectId)).data; }
      function canRead(data) {
        return isSelf(data.ownerId) || (active() && data.get('isShared', false) == true);
      }
      // المدير يحذف بيانات المستخدم المحظور وحده؛ مشاريع النشطين محمية حتى من المدير
      function adminPurge(data) { return isAdmin() && isBanned(data.ownerId); }

      allow read: if canRead(resource.data) || isAdmin();
      allow create: if active()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('description', '').size() <= 5000;
      allow update: if isSelf(resource.data.ownerId)
        && unchanged('ownerId')
        && request.resource.data.get('description', '').size() <= 5000;
      allow delete: if isSelf(resource.data.ownerId) || adminPurge(resource.data);

      // المجموعات الفرعية: analyses وdiagrams وdatabaseDesigns وreports
      match /{sub}/{docId} {
        allow read: if canRead(project()) || adminPurge(project());
        allow write: if isSelf(project().ownerId);
        allow delete: if adminPurge(project());
      }
    }

    // عدّ التحليلات على مستوى المنصة (T8.3): استعلام collectionGroup للمدير وحده
    match /{path=**}/analyses/{analysisId} {
      allow read: if isAdmin();
    }

    // القوالب، أي الأمثلة الجاهزة (T8.4): المنشور يقرؤه كل مسجّل، والمدير وحده يكتب
    match /templates/{templateId} {
      function validTemplate(d) {
        return d.keys().hasOnly(['title', 'description', 'language', 'published', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.description is string && d.description.size() <= 5000
          && d.language in ['ar', 'en']
          && d.published is bool;
      }
      allow read: if (active() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin() && validTemplate(request.resource.data);
      allow delete: if isAdmin();
    }

    // عدّاد الاستخدام اليومي (T4.11 / T4.12)
    // اليوم عدد صحيح بتوقيت UTC مثل 20261121، يُحسب من وقت الخادم فلا يمكن تزويره
    function today() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function dailyLimit() {
      let path = /databases/$(database)/documents/settings/limits;
      return exists(path) ? get(path).data.get('dailyAnalyses', 10) : 10;
    }
    match /usage/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // الزيادة بمقدار 1 فقط، أو البدء من 1 في يوم جديد، دون تجاوز الحدّ
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['day', 'count', 'updatedAt'])
        && request.resource.data.day == today()
        && request.resource.data.count == (
             resource == null || resource.data.day != today() ? 1 : resource.data.count + 1)
        && request.resource.data.count <= dailyLimit();
      allow delete: if isAdmin();
    }

    // إعدادات عامة (حدّ الاستخدام): يقرؤها المسجّل ويكتبها المدير
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
